{
  "name": "skali",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"yarn dev:api\" \"yarn dev:web\"",
    "dev:api": "cd backend && /root/.venv/bin/uvicorn server:app --host 0.0.0.0 --port 8001 --reload",
    "dev:web": "vite",
    "build": "vite build",
    "start": "vite --host 0.0.0.0 --port 3000",
    "start:api": "cd backend && python -m uvicorn server:app --host 0.0.0.0 --port 8001",
    "start:web": "vite preview --host 0.0.0.0 --port 3000",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "cap:sync": "vite build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@capgo/capacitor-social-login": "^7.0.0",
    "@livekit/components-react": "^2.9.24",
    "@livekit/components-styles": "^1.2.0",
    "@supabase/supabase-js": "2.109.0",
    "firebase": "^11.10.0",
    "livekit-client": "^2.22.0",
    "lucide-react": "^0.427.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
