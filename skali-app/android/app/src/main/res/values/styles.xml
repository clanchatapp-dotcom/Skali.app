<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15+ (API 35+) enforces edge-to-edge display and, on that target,
         ignores the runtime Window.setDecorFitsSystemWindows() call the
         Capacitor StatusBar plugin uses (that's why setOverlaysWebView(false)
         alone stopped working once targetSdkVersion hit 35/36). This theme flag
         is the only way left to actually opt back out, and it only exists from
         API 35 onward — hence this being a values-v35 override rather than a
         change to the base styles.xml (which still needs to work on older API
         levels that don't know this attribute). -->

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
